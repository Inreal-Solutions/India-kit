{
  "name": "@india-kit/core",
  "version": "0.1.0",
  "description": "Core validation and generators for India-specific identifiers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "clean": "rimraf dist",
    "prepare": "pnpm build"
  },
  "files": ["dist"],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Inreal-Solutions/India-kit.git"
  },
  "homepage": "https://github.com/Inreal-Solutions/India-kit",
  "bugs": {
    "url": "https://github.com/Inreal-Solutions/India-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vitest": "^1.0.0",
    "fast-check": "^3.0.0",
    "@types/node": "^20.5.1",
    "tslib": "^2.6.0",
    "tsup": "^6.6.0",
    "rimraf": "^5.0.0"
  }
}
