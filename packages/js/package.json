{
  "name": "@india-kit/js",
  "version": "0.1.0",
  "description": "JavaScript wrapper for india-kit core",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "prepare": "pnpm build",
  "publishConfig": { "access": "public" },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "dependencies": {
    "@india-kit/core": "workspace:~"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ./scripts/generate-dts.js",
    "dev": "tsup --watch",
    "clean": "rimraf dist"
  },

  "devDependencies": {
    "tsup": "^6.6.0",
    "rimraf": "^5.0.0"
  }
  ,"repository": {
    "type": "git",
    "url": "https://github.com/Inreal-Solutions/India-kit.git"
  },
  "homepage": "https://github.com/Inreal-Solutions/India-kit",
  "bugs": {
    "url": "https://github.com/Inreal-Solutions/India-kit/issues"
  }
}
