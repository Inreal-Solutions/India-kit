{
  "name": "india-kit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "sdks/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "pnpm -r run test",
    "prepare": "husky install",

    "release": "echo \"Run release workflow via CI\"",

    "release:dry:core": "cd packages/core && npx semantic-release --dry-run",
    "release:dry:js": "cd packages/js && npx semantic-release --dry-run",
    "release:dry:cli": "cd packages/cli && npx semantic-release --dry-run",
    "release:dry:all": "pnpm run release:dry:core && pnpm run release:dry:js && pnpm run release:dry:cli",

    "release:core": "cd packages/core && npx semantic-release",
    "release:js": "cd packages/js && npx semantic-release",
    "release:cli": "cd packages/cli && npx semantic-release",
    "release:all": "pnpm run release:core && pnpm run release:js && pnpm run release:cli"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "semantic-release": "^21.0.0",
    "@semantic-release/commit-analyzer": "^10.0.0",
    "@semantic-release/release-notes-generator": "^10.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/npm": "^9.0.0",
    "@semantic-release/github": "^9.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/exec": "^6.0.0",
    "husky": "^8.0.0",
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Inreal-Solutions/India-kit.git"
  },
  "homepage": "https://github.com/Inreal-Solutions/India-kit",
  "bugs": {
    "url": "https://github.com/Inreal-Solutions/India-kit/issues"
  }
}
